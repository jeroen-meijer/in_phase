{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["jobs"],
  "properties": {
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "output_playlist", "filters", "options", "inputs"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Unique identifier for the job"
          },
          "output_playlist": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Playlist name with template variables"
              },
              "description": {
                "type": "string",
                "description": "Playlist description with template variables"
              },
              "public": {
                "type": "boolean",
                "description": "Whether the playlist is public (only used when creating new playlist)"
              },
              "id": {
                "type": "string",
                "description": "Playlist ID, URI, or share URL to update instead of creating new"
              }
            }
          },
          "cover": {
            "type": "object",
            "required": ["image", "caption"],
            "properties": {
              "image": {
                "type": "string",
                "description": "Filename of cover image"
              },
              "caption": {
                "type": "string",
                "description": "Caption text with template variables"
              }
            }
          },
          "filters": {
            "type": "object",
            "properties": {
              "added_between_days": {
                "type": "integer",
                "minimum": 1,
                "description": "Deprecated: Use date_range instead. Number of days to look back for added tracks"
              },
              "date_range": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Last N days (backward compatible with added_between_days)"
                  },
                  {
                    "type": "string",
                    "enum": ["today", "current_week", "current_month", "current_year"],
                    "description": "String shortcut for common date ranges"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "days": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Last N days"
                      },
                      "weeks": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Last N weeks"
                      },
                      "months": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Last N months"
                      },
                      "start": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                        "description": "Start date (YYYY-MM-DD) for absolute range"
                      },
                      "end": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                        "description": "End date (YYYY-MM-DD) for absolute range"
                      }
                    },
                    "description": "Time unit or absolute date range"
                  }
                ],
                "description": "Flexible date range configuration"
              }
            }
          },
          "options": {
            "type": "object",
            "properties": {
              "deduplicate": {
                "type": "string",
                "enum": ["on_id", "on_match"],
                "description": "Deduplication strategy"
              },
              "add_playlist_tracks_based_on": {
                "type": "string",
                "enum": ["added_date", "release_date"],
                "description": "Which date to use for filtering playlist tracks"
              },
              "update_mode": {
                "type": "string",
                "enum": ["replace", "append"],
                "description": "How to update target playlist (only applies when output_playlist.id is specified)"
              }
            }
          },
          "inputs": {
            "type": "object",
            "properties": {
              "playlists": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9]{22}$",
                  "description": "Spotify playlist ID"
                }
              },
              "artists": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9]{22}$",
                  "description": "Spotify artist ID"
                }
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Label name"
                }
              }
            }
          }
        }
      }
    }
  }
}
